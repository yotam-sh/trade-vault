# TradeVault Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Flask secret key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# Set to 'true' only for local development. Never 'true' in production.
DEBUG=false

# Port the app listens on (default: 2501)
PORT=2501

# Absolute path to db.json (set automatically by docker-compose.yml)
# Bare-metal installs don't need this — it's auto-detected.
# DB_PATH=/data/db/db.json

# ── Per-session login (TOTP / Google Authenticator) ──────────────────────────
# Easiest setup is in the web UI: Settings → Maintenance → Login & Security →
# "Set up login" (scan the QR, no restart needed). Set TOTP_SECRET here only if you
# prefer env-managed auth. When both are unset, the login gate is DISABLED (fine for
# local-only dev).
TOTP_SECRET=
# How long a login stays valid (hours).
SESSION_LIFETIME_HOURS=12
# Set true when behind a reverse proxy / Cloudflare Tunnel so the app honors
# X-Forwarded-Proto (needed for Secure cookies) and CF-Connecting-IP.
TRUST_PROXY=true
# Send the session cookie only over HTTPS. Defaults to TRUST_PROXY's value.
SESSION_COOKIE_SECURE=true
# Optional labels shown in the authenticator app entry.
# TOTP_ISSUER=TradeVault
# TOTP_LABEL=tradevault
